# Copy to .env.local and fill in. Everything is optional: with no keys the app runs in full mock mode.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox > Create App) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- AI checks: gemini | anthropic | openai (leave empty for the heuristic engine) ---
LLM_PROVIDER=
LLM_API_KEY=
# Optional: OpenAI-compatible endpoint for LLM_PROVIDER=openai (e.g. https://openrouter.ai/api/v1)
LLM_BASE_URL=
# Optional model override. Defaults: gemini-2.5-flash, claude-sonnet-4-5, gpt-4.1-mini
LLM_MODEL=

# Public URL of the app, used for PayPal return links (set this when deployed)
APP_URL=

# Optional: require external agents to send "Authorization: Bearer <key>" to /api/firewall/check
AGENTLEASH_API_KEY=
