# Copy to .env.local and fill in. Everything is optional: with no keys the app runs in full mock mode.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox > Create App) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- AI checks: gemini | anthropic | openai (leave empty for the heuristic engine) ---
LLM_PROVIDER=
LLM_API_KEY=
# Optional: OpenAI-compatible endpoint for LLM_PROVIDER=openai (e.g. https://openrouter.ai/api/v1)
LLM_BASE_URL=
# Optional model override. Defaults: gemini-flash-lite-latest, claude-sonnet-4-5, gpt-4.1-mini
LLM_MODEL=

# Optional: comma-separated backup models tried when the main one is overloaded
LLM_FALLBACK_MODELS=

# --- Required when deployed publicly ---
# Public URL of the app (PayPal return links are built from this, never from the request's Host header)
APP_URL=
# Password for the dashboard, rules and approvals. Without it, a deployed app refuses to run owner pages.
OWNER_PASSWORD=

# Key external agents / the MCP server send as "Authorization: Bearer <key>" to /api/firewall/check.
# Required on a public deployment (the endpoint is disabled without it).
COUNTERSIGN_API_KEY=

# --- Countersign Guard for PayPal's MCP server (npm run paypal-guard), run on your own machine ---
# COUNTERSIGN_URL=https://your-countersign.onrender.com
# (also uses PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET and COUNTERSIGN_API_KEY above)
